# Copy to .env.local for `npm run dev` (and to .dev.vars for `npm run preview`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only needed to run the Playwright end-to-end tests locally (they create test users).
# The app itself never uses the service-role key.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_NAME=Endorse Commons
