{
  "name": "research-guild",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "learn:build": "node scripts/build-learn.mjs",
    "brand:render": "node scripts/render-brand.mjs",
    "readme:faq": "node --no-warnings scripts/sync-readme-faq.mjs",
    "predev": "npm run learn:build",
    "dev": "next dev",
    "prebuild": "npm run learn:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npm run learn:build && tsc --noEmit",
    "test": "npm run learn:build && vitest run",
    "test:db": "scripts/local-db/test.sh",
    "test:e2e": "playwright test",
    "preview": "npm run learn:build && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run learn:build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "15.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.144.0"
  }
}
